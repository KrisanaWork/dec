// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  admin
  teacher
  student

  @@map("user_role")
}

enum ExamType {
  quiz
  midterm
  final
  assignment

  @@map("exam_type")
}

enum ExamStatus {
  draft
  published
  closed

  @@map("exam_status")
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String?  @unique @db.VarChar(150)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  student      Student?
  teacher      Teacher?
  createdExams Exam[]      @relation("ExamCreatedBy")
  systemLogs   SystemLog[]

  @@map("users")
}

model AcademicYear {
  yearId    Int      @id @default(autoincrement()) @map("year_id")
  yearName  String   @map("year_name") @db.VarChar(20)
  semester  Int      @db.TinyInt
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")

  classes         Class[]
  subjectTeachers SubjectTeacher[]

  @@map("academic_years")
}

model Teacher {
  teacherId   Int     @id @default(autoincrement()) @map("teacher_id")
  userId      Int     @unique @map("user_id")
  teacherCode String  @unique @map("teacher_code") @db.VarChar(20)
  department  String? @db.VarChar(100)
  titleName   String  @map("title_name") @db.VarChar(20)
  firstName   String  @map("first_name") @db.VarChar(100)
  middleName  String? @map("middle_name") @db.VarChar(100)
  lastName    String  @map("last_name") @db.VarChar(100)

  user               User                    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  homeroomClasses    Class[]                 @relation("HomeroomTeacher")
  subjectAssignments SubjectTeacher[]
  invigilatorDuties  InvigilatorAssignment[]

  @@map("teachers")
}

model Class {
  classId           Int    @id @default(autoincrement()) @map("class_id")
  className         String @map("class_name") @db.VarChar(20)
  gradeLevel        Int    @map("grade_level") @db.TinyInt
  yearId            Int    @map("year_id")
  homeroomTeacherId Int?   @map("homeroom_teacher_id")

  year            AcademicYear            @relation(fields: [yearId], references: [yearId])
  homeroomTeacher Teacher?                @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [teacherId])
  students        Student[]
  subjectTeachers SubjectTeacher[]
  examClasses     ExamClass[]
  invigilators    InvigilatorAssignment[]

  @@map("classes")
}

model Student {
  studentId   Int     @id @default(autoincrement()) @map("student_id")
  userId      Int     @unique @map("user_id")
  studentCode String  @unique @map("student_code") @db.VarChar(20)
  classId     Int     @map("class_id")
  studentNo   Int     @map("student_no") @db.TinyInt
  titleName   String  @map("title_name") @db.VarChar(20)
  firstName   String  @map("first_name") @db.VarChar(100)
  middleName  String? @map("middle_name") @db.VarChar(100)
  lastName    String  @map("last_name") @db.VarChar(100)

  user       User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  class      Class           @relation(fields: [classId], references: [classId])
  accessLogs ExamAccessLog[]

  @@map("students")
}

model Subject {
  subjectId   Int    @id @default(autoincrement()) @map("subject_id")
  subjectCode String @unique @map("subject_code") @db.VarChar(20)
  subjectName String @map("subject_name") @db.VarChar(150)
  gradeLevel  Int    @map("grade_level") @db.TinyInt

  subjectTeachers SubjectTeacher[]
  exams           Exam[]

  @@map("subjects")
}

model SubjectTeacher {
  id        Int @id @default(autoincrement())
  teacherId Int @map("teacher_id")
  subjectId Int @map("subject_id")
  classId   Int @map("class_id")
  yearId    Int @map("year_id")

  teacher Teacher      @relation(fields: [teacherId], references: [teacherId])
  subject Subject      @relation(fields: [subjectId], references: [subjectId])
  class   Class        @relation(fields: [classId], references: [classId])
  year    AcademicYear @relation(fields: [yearId], references: [yearId])

  @@unique([teacherId, subjectId, classId, yearId], name: "uq_assignment")
  @@map("subject_teachers")
}

model Exam {
  examId       Int      @id @default(autoincrement()) @map("exam_id")
  examName     String   @map("exam_name") @db.VarChar(200)
  subjectId    Int      @map("subject_id")
  createdBy    Int      @map("created_by")
  examType     ExamType @map("exam_type")
  platformName String?  @map("platform_name") @db.VarChar(100)
  startTime    DateTime @map("start_time")
  endTime      DateTime @map("end_time")
  instructions String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  subject        Subject         @relation(fields: [subjectId], references: [subjectId])
  creator        User            @relation("ExamCreatedBy", fields: [createdBy], references: [userId])
  examClasses    ExamClass[]
  examAccessLogs ExamAccessLog[]

  @@index([startTime, endTime], name: "idx_exams_schedule")
  @@map("exams")
}

model ExamClass {
  id       Int        @id @default(autoincrement())
  examId   Int        @map("exam_id")
  classId  Int        @map("class_id")
  examLink String     @default("") @map("exam_link") @db.VarChar(500)
  status   ExamStatus @default(draft)

  exam       Exam            @relation(fields: [examId], references: [examId], onDelete: Cascade)
  class      Class           @relation(fields: [classId], references: [classId])
  accessLogs ExamAccessLog[]

  @@unique([examId, classId], name: "uq_exam_class")
  @@map("exam_classes")
}

model ExamAccessLog {
  logId       Int      @id @default(autoincrement()) @map("log_id")
  examClassId Int      @map("exam_class_id")
  studentId   Int      @map("student_id")
  clickedAt   DateTime @default(now()) @map("clicked_at")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  deviceInfo  String?  @map("device_info") @db.VarChar(255)

  examClass  ExamClass @relation(fields: [examClassId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [studentId])
  exam       Exam?     @relation(fields: [examExamId], references: [examId])
  examExamId Int?

  @@index([examClassId], name: "idx_access_exam_class")
  @@index([studentId], name: "idx_access_student")
  @@map("exam_access_logs")
}

model SystemLog {
  logId     Int      @id @default(autoincrement()) @map("log_id")
  userId    Int      @map("user_id")
  action    String   @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("system_logs")
}

model InvigilatorAssignment {
  id         Int     @id @default(autoincrement())
  classId    Int     @map("class_id")
  roomNumber String? @map("room_number") @db.VarChar(20)
  teacherId  Int     @map("teacher_id")
  slot       Int     @default(1) // ลำดับกรรมการคุมสอบในห้องนั้น เช่น 1, 2

  class   Class   @relation(fields: [classId], references: [classId], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [teacherId])

  @@unique([classId, slot], name: "uq_class_slot")
  @@map("invigilator_assignments")
}
